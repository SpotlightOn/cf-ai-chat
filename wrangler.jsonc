{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-ai",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "ai": {
    "binding": "AI"
  },
  "workers_dev": true,
  "observability": {
    "enabled": true
  }
}
